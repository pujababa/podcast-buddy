# ==========================================
# Podcast Buddy - Environment Configuration
# ==========================================

# Flask Server Configuration
FLASK_APP=backend/app.py
FLASK_ENV=development
FLASK_DEBUG=1
PORT=5000
HOST=127.0.0.1

# Database Configuration (SQLite)
DATABASE_PATH=podcast_buddy.db

# News Discovery API (Phase 3: SerpAPI - Server-Side Only)
SERPAPI_API_KEY=your_serpapi_api_key_here
SERPAPI_CONNECT_TIMEOUT=5.0
SERPAPI_READ_TIMEOUT=10.0

# AI Summarization & Intelligence (Phase 5: Gemini AI - Server-Side Only)
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-3.8-flash

# Text-to-Speech & Audio Processing (Server-Side Only)
# Microsoft Edge Neural TTS voices (hi-IN-MadhurNeural, hi-IN-SwaraNeural) require no API key.
# Genuine Odia TTS is powered by Sarvam AI Bulbul (od-IN). Obtain key from: https://dashboard.sarvam.ai
SARVAM_API_KEY=your_sarvam_api_key_here
TTS_API_KEY=
AUDIO_OUTPUT_DIR=generated_audio
